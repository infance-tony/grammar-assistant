# ============================
# Grammar Assistant .gitignore
# ============================

# ── Claude / AI assistants ────────────────────────────────
.claude/
.agents/
.agents.md
.gemini/

# ── Python ────────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.Python
pip-log.txt
pip-delete-this-directory.txt
.env
*.env

# ── PyInstaller build output ──────────────────────────────
backend/dist/
backend/build/
# NOTE: grammar_backend.spec IS committed (needed to rebuild)

# ── Flutter / Dart ────────────────────────────────────────
frontend/.dart_tool/
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.metadata

# ── AI Models (too large for git — download separately) ───
*.gguf
backend/models/*.gguf

# ── Installer output & compiled binaries ──────────────────
dist/
*.exe
*.msi
*.tmp

# ── IDE ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs ──────────────────────────────────────────────────
*.log
*.bak
test_ui.html
